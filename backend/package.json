{
  "name": "ciranda-web-backend",
  "version": "2.0.0",
  "private": true,
  "description": "API do Ciranda Web em NestJS, com Prisma e Swagger",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.3",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/swagger": "^12.1.3",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.11",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.2",
    "esbuild": "^0.28.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  },
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "npm run build && node dist/main.js",
    "start:e2e": "node scripts/subir-para-e2e.mjs",
    "test": "vitest run --coverage",
    "migrar": "prisma migrate dev",
    "migrar:producao": "prisma migrate deploy",
    "migracoes:empacotar": "node scripts/empacotar-migracoes.mjs",
    "empacotar": "esbuild src/vercel.ts --bundle --platform=node --format=esm --packages=external --outfile=pacote/api.mjs --log-level=warning",
    "build:vercel": "prisma generate && npm run empacotar"
  },
  "overrides": {
    "effect": "3.22.5"
  }
}
